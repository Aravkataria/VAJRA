# VAJRA Environment Configuration Example
# Copy this file to .env and configure for your deployment.

# =====================================================================
# 1. APPLICATION ENVIRONMENT & DEBUG
# =====================================================================
VAJRA_ENV=production
VAJRA_DEBUG=false
PORT=8000

# =====================================================================
# 2. SECURITY & AUTHENTICATION
# =====================================================================
# Server-to-server shared secret for authenticating backend RPC (e.g. Render -> HF Space).
# Generate a cryptographically secure key: openssl rand -hex 32
# If unset, signature verification fails closed and public requests are governed by IP rate limits.
VAJRA_SECRET_KEY=

# Set to 'true' to require API key or signature on /api/chat (disallows unauthenticated public guests)
VAJRA_REQUIRE_AUTH=false

# Optional admin API key to protect admin endpoints
VAJRA_API_KEY=

# Allowed CORS origins (comma-separated)
VAJRA_ALLOWED_ORIGINS=https://aravkataria.github.io,http://localhost:8000,http://127.0.0.1:8000

# Rate limits (requests per minute per IP)
VAJRA_RATE_LIMIT=120
VAJRA_PIPELINE_RATE_LIMIT=30
VAJRA_CHAT_RATE_LIMIT=10

# =====================================================================
# 3. AI MODELS & RUNTIME CONFIGURATION
# =====================================================================
# Analyst mode: "deterministic" or "ollama"
VAJRA_ANALYST_MODE=deterministic

# Repair mode: "deterministic" or "ollama"
VAJRA_REPAIR_MODE=deterministic

# Model versions
VAJRA_MODEL1_VERSION=v1.0.0
VAJRA_MODEL2_VERSION=v1.0.0

# Concurrency control (default 1 for rock-solid memory/GPU stability)
VAJRA_MAX_CONCURRENT_INFERENCE=1
VAJRA_MAX_REPAIR_ATTEMPTS=3

# Optional: Third-party LLM providers
OPENAI_API_KEY=
